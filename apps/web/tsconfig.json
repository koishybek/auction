{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next собирает сам, tsc здесь только проверяет типы.
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "next-env.d.ts", ".next/types/**/*", "*.ts", "*.mjs"],
  "exclude": ["node_modules", ".next"]
}
