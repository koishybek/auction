{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],

    // DI в NestJS читает типы конструкторов из метаданных, которые emit'ит tsc.
    // Поэтому же сборку нельзя переводить на esbuild/swc без отдельной настройки.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"]
}
