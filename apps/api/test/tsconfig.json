{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Тесты не собираются tsc — их компилирует SWC внутри vitest.
    // Этот tsconfig нужен typecheck'у и типовым правилам ESLint: projectService
    // берёт ближайший tsconfig.json, поэтому файл лежит прямо в test/.
    "noEmit": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["./**/*", "../src/**/*"]
}
