# Шаблон окружения. Скопировать в .env (он в .gitignore) и заполнить.
# Как получить строки подключения — docs/dev-setup.md
#
# Файл растёт по мере задач. Сейчас закрыт T-002 (БД и Redis).
# Ключи шифрования ПДн придут в T-008, JWT — в T-011, S3 — в T-016.

# ─── Приложение ───────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001

# ─── PostgreSQL (Neon) ────────────────────────────────────────────────────
# DATABASE_URL — пулер (через него ходит приложение).
# DIRECT_URL   — прямое соединение без пулера: нужно Prisma для миграций,
#                потому что DDL и advisory-локи через PgBouncer не работают.
# Оба обязаны быть с sslmode=require: Neon без TLS не пускает.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/auction?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/auction?sslmode=require

# ─── Redis (Redis Cloud) ──────────────────────────────────────────────────
# rediss:// (две s) — TLS. Redis Cloud выдаёт хост вида
# redis-12345.c123.eu-central-1-1.ec2.redns.redis-cloud.com:12345
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
