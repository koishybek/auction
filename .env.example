# Шаблон окружения. Скопировать в .env (он в .gitignore) и заполнить.
# Как получить строки подключения — docs/dev-setup.md
#
# Файл растёт по мере задач. Сейчас закрыт T-002 (БД и Redis).
# Ключи шифрования ПДн придут в T-008, JWT — в T-011, S3 — в T-016.

# ─── Приложение ───────────────────────────────────────────────────────────
# Порты 3100/3101, а не привычные 3000/3001: 3000 на dev-машине уже занят
# другим проектом, причём только на IPv6 (::1) — из-за этого localhost:3000
# открывает чужое приложение, а 127.0.0.1:3000 наше. Ловушка на пустом месте.
NODE_ENV=development
API_PORT=3100
WEB_PORT=3101

# ─── PostgreSQL ───────────────────────────────────────────────────────────
# Dev — локальный PostgreSQL 17 на порту 5433 (аутентификация trust).
# Без sslmode: localhost не шифруем сознательно, см. docs/dev-setup.md.
#
# DATABASE_URL — через него ходит приложение.
# DIRECT_URL   — соединение без пулера: Prisma нужны DDL и advisory-локи, а через
#                PgBouncer в transaction-режиме они не работают. Локально пулера
#                нет, поэтому обе строки совпадают. На stage/prod они разойдутся.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/auction
DIRECT_URL=postgresql://postgres@127.0.0.1:5433/auction

# ─── Redis ────────────────────────────────────────────────────────────────
# Managed (Redis Cloud): нативного Redis под Windows нет, локально не поднять.
# rediss:// (две s) — TLS обязателен, соединение уходит с машины.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
