# Шаблон окружения. Скопировать в .env (он в .gitignore) и заполнить.
# Как получить строки подключения — docs/dev-setup.md
#
# Файл растёт по мере задач. Сейчас закрыт T-002 (БД и Redis).
# Ключи шифрования ПДн придут в T-008, JWT — в T-011, S3 — в T-016.

# ─── Приложение ───────────────────────────────────────────────────────────
# Порты 3100/3101, а не привычные 3000/3001: 3000 на dev-машине уже занят
# другим проектом, причём только на IPv6 (::1) — из-за этого localhost:3000
# открывает чужое приложение, а 127.0.0.1:3000 наше. Ловушка на пустом месте.
NODE_ENV=development
API_PORT=3100
WEB_PORT=3101
# WebSocket-gateway торгов. Там же отдаётся /health для проб Kubernetes.
GATEWAY_PORT=3200

# Сколько доверенных прокси стоит перед API. 0 — никого, адрес берётся из сокета.
# Именно число, а не «true»: X-Forwarded-For дописывает кто угодно, включая
# самого клиента, и доверие всему заголовку целиком делает подмену адреса
# однострочником. От адреса зависят антинакрутка просмотров и лимит ставок.
# Прод: Cloudflare + ingress = 2.
TRUST_PROXY_HOPS=0

# Доверять заголовку CF-Connecting-IP от Cloudflare (T-050).
# Включать ТОЛЬКО когда origin закрыт для всех, кроме сетей Cloudflare
# (infra/cloudflare/README.md). Пока origin открыт, включённый флаг означает,
# что лимит ставок и антинакрутка просмотров верят заголовку атакующего.
TRUST_CLOUDFLARE_IP=false

# Секрет Cloudflare Turnstile (ОВ-5). Пусто — работает мок капчи.
# В production пустое значение роняет старт: тихий мок на боевом контуре —
# это открытая дверь, а не деградация.
TURNSTILE_SECRET_KEY=

# ─── PostgreSQL ───────────────────────────────────────────────────────────
# Dev — локальный PostgreSQL 17 на порту 5433 (аутентификация trust).
# Без sslmode: localhost не шифруем сознательно, см. docs/dev-setup.md.
#
# DATABASE_URL — через него ходит приложение.
# DIRECT_URL   — соединение без пулера: Prisma нужны DDL и advisory-локи, а через
#                PgBouncer в transaction-режиме они не работают. Локально пулера
#                нет, поэтому обе строки совпадают. На stage/prod они разойдутся.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/auction
DIRECT_URL=postgresql://postgres@127.0.0.1:5433/auction

# ─── Redis ────────────────────────────────────────────────────────────────
# Dev — Redis 7.2 на localhost (Memurai Developer, запускается процессом без
# прав администратора; подробности и установка — docs/dev-setup.md).
# Managed-вариант: rediss:// (две s) — TLS обязателен, соединение уходит с машины.
REDIS_URL=redis://127.0.0.1:6379

# Префикс всех ключей приложения. Разводит стенды и прогон e2e на одном
# инстансе: у managed-Redis отдельной логической базы под тесты обычно нет.
REDIS_NAMESPACE=auction

# Как часто накопленные просмотры лотов сбрасываются из Redis в PostgreSQL.
# Операционная ручка: на корректность не влияет, недосброшенное всё равно
# прибавляется к ответу на лету.
LOT_VIEWS_FLUSH_MS=30000

# ─── Шифрование ПДн (T-008) ───────────────────────────────────────────────
# Ровно 32 байта в base64. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# В проде ключи живут в KMS, а не в файле. Ключи должны быть РАЗНЫЕ.
PII_ENCRYPTION_KEY=
PII_BLIND_INDEX_KEY=

# ─── JWT (T-011) ──────────────────────────────────────────────────────────
# Минимум 32 символа, секреты должны быть РАЗНЫЕ.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Фоновые задачи (T-020) ───────────────────────────────────────────────
# Период перепроверки лотов в КИСИП/ЕРД. ТЗ §5.1 требует раз в 24 часа.
# Ручка нужна прежде всего stage: ждать сутки ради проверки крона бессмысленно.
REGISTRY_RECHECK_INTERVAL_MS=86400000

# ─── Хранилище файлов (T-016) ─────────────────────────────────────────────
# Локальный диск, пока нет реквизитов S3. Каталог в .gitignore.
STORAGE_LOCAL_ROOT=.storage
