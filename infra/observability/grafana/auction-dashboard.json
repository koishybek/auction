{
  "title": "Аукцион — Smart Hammer 50s",
  "uid": "auction-smart-hammer",
  "tags": ["auction", "sla"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "description": "Приёмочные величины §6 ТЗ: обработка ставки, вещание, качество связи, размеры комнат. Пороги на графиках — из ОВ-2 и ТЗ §2.2, не из общих соображений.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLA обработки ставки (NFR-02, ОВ-2)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Обработка ставки: p50 / p95 / p99",
      "description": "Полный серверный путь ставки: лимит частоты, антибот, права, ядро. Именно эта величина сверяется с ≤15 мс. Красная линия — сам порог.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.015 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "auction:bid_duration_seconds:p50_5m",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "auction:bid_duration_seconds:p95_5m",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "C",
          "expr": "auction:bid_duration_seconds:p99_5m",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Где именно медленно: ядро против полного пути",
      "description": "Разница между линиями — это проверки прав до ядра (три запроса в PostgreSQL). Нагрузочный прогон T-051 показал, что основной вклад даёт именно она, а не Lua.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "auction:bid_duration_seconds:p99_5m",
          "legendFormat": "полный путь, p99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "auction:bid_core_duration_seconds:p99_5m",
          "legendFormat": "ядро (Lua), p99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Вещание: постановка события в отправку, p99",
      "description": "ОВ-2 задаёт вещание как «время постановки в отправку» — порог 5 мс. Растёт линейно по числу подписчиков комнаты.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.005 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "auction:broadcast_duration_seconds:p99_5m",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Поток ставок по исходу",
      "description": "outcome=error — исключение на пути ставки: участник не знает, принята она или нет. Любое ненулевое значение здесь означает инцидент.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 20 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(auction_bids_total[5m]))",
          "legendFormat": "{{outcome}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Зал: связь и размеры комнат (NFR-03, FR-08)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Доля клиентов с деградировавшей связью",
      "description": "Ответ на ping дольше 2 с. При 40 % торги уходят в SLA Freeze (ТЗ §2.2) — красная линия ровно там, где сработает механика.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "auction:heartbeat:degraded_share_2m",
          "legendFormat": "деградировало",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Соединения и комнаты",
      "description": "Самая большая комната показывает запас до требуемых NFR-03 пятидесяти тысяч на лот. Метки лота нет намеренно: серия на каждый лот развалила бы Prometheus.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(auction_gateway_connections)",
          "legendFormat": "соединений всего",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "sum(auction_gateway_rooms)",
          "legendFormat": "комнат",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "C",
          "expr": "max(auction_gateway_room_connections_max)",
          "legendFormat": "самая большая комната",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Тики таймера: частота рассылки",
      "description": "Тик обязан идти раз в секунду на каждую занятую комнату (ТЗ §2.1). Ноль при непустых комнатах — самый тихий отказ системы: у клиентов просто замирает таймер.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(auction_broadcast_duration_seconds_count[5m]))",
          "legendFormat": "{{event}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Задержка event loop, p99",
      "description": "Пауза event loop — механизм, которым GC ломает таймер торгов (риск R-5). Спорный финиш иначе нечем объяснить.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job) (nodejs_eventloop_lag_p99_seconds)",
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Перенос ставок в PostgreSQL (FR-04)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Очередь переноса и карантин",
      "description": "Ставку принимает Redis, юридической записью она становится в PostgreSQL. Пока очередь не разгружается, в зале всё выглядит нормально, а протокол торгов соберётся неполным. Карантин — ставки, которые база отказалась принять: сами они уже не запишутся.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "в карантине" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(auction_bid_outbox_pending)",
          "legendFormat": "ждут записи",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "sum(auction_bid_outbox_dead)",
          "legendFormat": "в карантине",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Ставок записано в секунду",
      "description": "Сверять с потоком принятых ставок: расхождение означает, что часть ставок висит в очереди или ушла в карантин.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(auction_bid_outbox_written_total[5m]))",
          "legendFormat": "записано",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "sum(rate(auction_bid_outbox_quarantined_total[5m]))",
          "legendFormat": "в карантин",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Закрытые торги без записи в базе",
      "description": "Скрипт закрытия необратимо снимает лот с индекса дедлайнов. Если запись в PostgreSQL после этого не удалась, у лота нет ни возврата задатков, ни протокола, а в каталоге он выглядит нормально закрытым. Ноль — норма.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(auction_finish_unpersisted)",
          "legendFormat": "ждут фиксации",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    }
  ]
}
