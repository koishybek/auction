{
  "name": "auction",
  "version": "0.0.0",
  "private": true,
  "description": "Платформа «Цифровой гибридный аукцион скоростных продаж»",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:browser": "pnpm --filter @auction/e2e test:browser",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env": "pnpm --filter @auction/api check:env",
    "demo": "node scripts/demo.mjs",
    "db:generate": "pnpm --filter @auction/api db:generate",
    "db:migrate": "pnpm --filter @auction/api db:migrate",
    "db:deploy": "pnpm --filter @auction/api db:deploy",
    "db:status": "pnpm --filter @auction/api db:status",
    "db:studio": "pnpm --filter @auction/api db:studio",
    "db:erd": "pnpm --filter @auction/api db:erd",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
